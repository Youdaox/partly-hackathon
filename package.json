{
  "name": "partli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@partli/web",
    "dev:shared": "pnpm --filter @partli/shared dev",
    "api": "backend/.venv/bin/uvicorn app.main:app --port 8080 --app-dir backend",
    "apiw": "node scripts/venv-run.mjs uvicorn app.main:app --port 8080 --app-dir backend --reload",
    "api:install": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -e 'backend[dev]'",
    "api:test": "backend/.venv/bin/python -m pytest backend/tests -q",
    "api:warm": "cd backend && .venv/bin/python -m scripts.warm_cache",
    "mobile": "pnpm --filter @partli/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "smoke": "node scripts/smoke.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
