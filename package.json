{
  "name": "partli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@partli/api --filter=@partli/web",
    "dev:shared": "pnpm --filter @partli/shared dev",
    "mobile": "pnpm --filter @partli/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "smoke": "node scripts/smoke.mjs",
    "seed": "pnpm --filter @partli/api seed",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
