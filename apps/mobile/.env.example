# Copy to .env. Only EXPO_PUBLIC_* variables reach the app bundle.

# Where the API lives.
#
# Leave this UNSET when running on a phone via Expo Go: the app reuses the LAN IP
# Metro is already serving from, which is the machine running the API.
#
# Set it when that guess is wrong, or when running the web build:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
# EXPO_PUBLIC_API_URL=http://localhost:4000

# Where the FastAPI prediction backend lives. Same rule: leave UNSET on a phone and the
# app reuses Metro's LAN IP on port 8080.
#
# Set it to the Next port to run everything through a single origin — Next proxies
# /v1/* to the backend (see apps/web/next.config.ts), so this is all you change:
#   EXPO_PUBLIC_BACKEND_URL=http://192.168.1.42:3000
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8080
