{
  "name": "@first-look/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \"**/.pglite/**\" --ignore \"**/node_modules/**\" src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/scripts/seed-graph.ts",
    "clean": "rm -rf dist .turbo .pglite"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@first-look/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.9",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
