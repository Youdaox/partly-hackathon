# Copy to .env and adjust. Everything here has a working default.

# Postgres from docker-compose (`pnpm db:up`).
# Leave this UNSET to use the embedded PGlite dev database instead — the API runs
# with no Docker at all, storing data in apps/api/.pglite.
DATABASE_URL=postgres://firstlook:firstlook@localhost:5432/firstlook

# Port the API listens on.
PORT=4000

# Where the web app is served from. Used to build customer approval links,
# so this must be reachable from the customer's phone.
WEB_BASE_URL=http://localhost:3000

# Overrides where the dataset is read from. Defaults to the repo's data/ folder.
# DATA_DIR=../../data

# --- Optional: real voice transcription -------------------------------------
# The mobile app ships with a text-input stub. Add a key here when wiring up
# speech-to-text for the live capture screen.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
